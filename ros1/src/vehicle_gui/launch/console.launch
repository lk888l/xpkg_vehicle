<launch>
  <arg name="config" default="$(find vehicle_driver)/config/vehicle.yaml"/>
  <arg name="namespace" default="/"/>
  <arg name="can_interface" default="can0"/>
  <arg name="imu_can_interface" default="can1"/>
  <arg name="start_driver" default="true"/>
  <arg name="start_imu" default="$(arg start_driver)"/>
  <arg name="receive_only" default="true"/>
  <arg name="auto_initialize" default="false"/>
  <arg name="auto_imu_calibration" default="false"/>
  <arg name="use_stamped_cmd_vel" default="true"/>
  <arg name="quit_after" default="0"/>
  <group ns="$(arg namespace)">
    <node pkg="vehicle_driver" type="vehicle_node" name="vehicle" output="screen" if="$(arg start_driver)">
      <rosparam command="load" file="$(arg config)"/>
      <param name="can_interface" value="$(arg can_interface)"/>
      <param name="receive_only" value="$(arg receive_only)"/>
      <param name="auto_initialize" value="$(arg auto_initialize)"/>
      <param name="auto_imu_calibration" value="$(arg auto_imu_calibration)"/>
      <param name="use_stamped_cmd_vel" value="$(arg use_stamped_cmd_vel)"/>
    </node>
    <node pkg="vehicle_driver" type="imu_node" name="imu" output="screen" if="$(arg start_imu)">
      <rosparam command="load" file="$(arg config)"/>
      <param name="imu_can_interface" value="$(arg imu_can_interface)"/>
    </node>
    <node pkg="vehicle_gui" type="vehicle_gui" name="vehicle_gui" output="screen" required="true"
          args="--quit-after $(arg quit_after)">
      <param name="use_stamped_cmd_vel" value="$(arg use_stamped_cmd_vel)"/>
    </node>
  </group>
</launch>
