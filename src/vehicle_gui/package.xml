<?xml version="1.0"?>
<package format="3">
  <name>vehicle_gui</name><version>1.0.0</version>
  <description>PyQt5 desktop control and telemetry console for the MARK1 ROS 2 driver.</description>
  <maintainer email="207119930@qq.com">Luka</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>vehicle_interfaces</exec_depend>
  <exec_depend>vehicle_driver</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-pyqtgraph</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
